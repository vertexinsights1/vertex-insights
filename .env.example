# Set these in Netlify > Site configuration > Environment variables. Never commit real values.
# --- Public (safe in browser; protected by row-level security) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# --- Server-only secrets ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Netlify > Site configuration > Build & deploy > Build hooks > create one, paste its URL
BUILD_HOOK_URL=
# Comma-separated: your real domain AND the .netlify.app URL
ALLOWED_ORIGINS=https://your-domain.com,https://your-site.netlify.app
# Optional email alerts via Resend (verified sender domain required)
RESEND_API_KEY=
NOTIFICATION_EMAIL=
FROM_EMAIL=Vertex Insights <notifications@your-verified-domain.example>
